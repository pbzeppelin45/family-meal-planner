# Supabase public project URL and publishable/anon key.
# These may be exposed to browser code; Row Level Security protects family data.
# Obtain from Supabase Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never add a Supabase service_role key to NEXT_PUBLIC_ variables.
